@using Tracker.Domain
@model Dictionary<Tracker.Domain.YearMonth, IEnumerable<Tracker.Controllers.Envelope>>

@{
    ViewData["Title"] = "Budgets";
}


<div>&ac;########### Month Picker ###########&ac;</div>
@* <div> *@
@*     <partial name="MonthSummary" model="@Model.Month" /> *@
@* </div> *@

<table>
    <thead>
        <tr>
            <th scope="col">
                <div class="f-row">
                    <button hx-target="next tbody" hx-swap="afterbegin" hx-action="@Url.Action("Add", "Categories")">Categories ➕</button>
                    <button>↥</button>
                    <button>↧</button>
                </div>
            </th>
            <th scope="col">Budgeted <span>@Model.First().Value.First().Budgeted</span></th>
            <th scope="col">Outflows <span>@Model.First().Value.First().Allocated</span></th>
            <th scope="col">Balance <span>@Model.First().Value.First().Balance</span></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model[Model.Keys.First()])
        {
            <tr>
                <th scope="row">
                    <span>@row.Category.Name</span>
                    @* <span hx-action="@Url.Action("InlineEditName", "Categories", new { Id = row.Category.Id })" hx-trigger="click" hx-swap="outerHTML">
                        @row.Category.Name
                    </span> *@
                </th>
                <td>
                </td>
                <td>@row.Allocated</td>
                <td>@row.Balance</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th scope="row">Totals</th>
            <td></td>
            <td></td>
            <td></td>
        </tr>
    </tfoot>
</table>
